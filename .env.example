# PostgreSQL and existing local administration
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/histology_viewer
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-value
# TEACHER_ACCOUNTS='[{"login":"teacher","password":"change-me"}]'

# Moodle LTI 1.3 / LTI Advantage. Never commit real private keys or Moodle secrets.
LTI_TOOL_NAME=Гистологический атлас
LTI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
LTI_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
LTI_KEY_ID=histology-viewer-lti-key
LTI_PLATFORM_ISSUER=https://moodle.example.edu
LTI_CLIENT_ID=replace-with-moodle-client-id
LTI_DEPLOYMENT_ID=replace-with-moodle-deployment-id
LTI_AUTH_LOGIN_URL=https://moodle.example.edu/mod/lti/auth.php
LTI_AUTH_TOKEN_URL=https://moodle.example.edu/mod/lti/token.php
LTI_PLATFORM_JWKS_URL=https://moodle.example.edu/mod/lti/certs.php
LTI_REDIRECT_URI=https://atlas.example.edu/lti/launch
LTI_COOKIE_SECURE=true
LTI_SESSION_SECRET=replace-with-a-different-long-random-value

# Local development only. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=false
DEV_AUTH_ROLE=teacher_full
DEV_AUTH_COURSE_ID=dev-course
DEV_AUTH_GROUP_ID=dev-group
