# Production environment example for Histology Viewer.
# Copy to the real server environment file, replace every secret, and do not commit real values.

NODE_ENV=production
AUTH_MODE=local
ENABLE_MOODLE_LTI=false
PORT=4000

# PostgreSQL. Match the port/database/user to the real server cluster.
# Example from the current local machine used port 5433, but production may use 5432.
DATABASE_URL=postgres://histology_user:replace-with-strong-db-password@127.0.0.1:5432/histology_viewer

# Local admin panel. Never use test123/change-me in production.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional legacy teacher access. Prefer creating users in /admin -> Пользователи.
# TEACHER_ACCOUNTS='[{"login":"ivanov","password":"replace-with-strong-password"}]'
# TEACHER_PASSWORD=replace-with-strong-shared-teacher-password

# Backups created by backend for PostgreSQL-backed metadata.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Moodle/LTI mode. Enable only on Moodle deployment branch/server.
# AUTH_MODE=moodle_lti
# ENABLE_MOODLE_LTI=true
# LTI_TOOL_NAME=Гистологический атлас
# LTI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
# LTI_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# LTI_KEY_ID=histology-viewer-lti-key
# LTI_PLATFORM_ISSUER=https://moodle.example.edu
# LTI_CLIENT_ID=replace-with-moodle-client-id
# LTI_DEPLOYMENT_ID=replace-with-moodle-deployment-id
# LTI_AUTH_LOGIN_URL=https://moodle.example.edu/mod/lti/auth.php
# LTI_AUTH_TOKEN_URL=https://moodle.example.edu/mod/lti/token.php
# LTI_PLATFORM_JWKS_URL=https://moodle.example.edu/mod/lti/certs.php
# LTI_REDIRECT_URI=https://atlas.example.edu/lti/launch
# LTI_COOKIE_SECURE=true
# LTI_SESSION_SECRET=replace-with-a-different-long-random-value

# Development bypass must stay disabled in production.
DEV_AUTH_BYPASS=false
DEV_AUTH_ROLE=teacher_full
DEV_AUTH_COURSE_ID=dev-course
DEV_AUTH_GROUP_ID=dev-group
